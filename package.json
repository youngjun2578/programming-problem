{
  "name": "ncs-math-diagnosis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run validate:advanced:quick && npm run test:advanced:independence:quick && npm run typecheck && vite build && npm run check:production",
    "preview": "vite preview",
    "test:golden": "tsx scripts/golden-compare.ts",
    "test:api": "tsx scripts/api-test.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "test:gating": "tsx scripts/gating-test.ts",
    "check:guides": "tsx scripts/guides/check-dist.ts",
    "validate:advanced": "tsx scripts/validate-advanced.ts",
    "validate:advanced:quick": "tsx scripts/validate-advanced.ts --quick",
    "test:advanced": "tsx scripts/advanced-recheck.ts",
    "test:advanced:independence": "tsx scripts/advanced-independence.ts",
    "test:advanced:independence:quick": "tsx scripts/advanced-independence.ts --quick",
    "test:golden:advanced": "tsx scripts/golden-advanced.ts",
    "check:production": "tsx scripts/check-production.ts",
    "guides": "tsx scripts/guides/build.ts --drafts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "marked": "18.0.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "pretendard": "^1.3.9"
  }
}
